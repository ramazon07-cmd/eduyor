DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
POSTGRES_DB=eduyor
POSTGRES_USER=eduyor
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Required before reservations are accepted. Do not put real payment information in Git.
# Use your actual recipient/bank instructions only when ready to receive funds.
PAYMENT_INSTRUCTIONS=
PAYMENT_SUPPORT=Administrator bilan bog‘laning
TRUST_PROXY_HTTPS=0
# Brevo SMTP for sign-up codes (brevo.com > SMTP & API). Leave EMAIL_HOST empty to print codes to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Must be a sender address verified in Brevo.
DEFAULT_FROM_EMAIL=EduYor <no-reply@example.com>
