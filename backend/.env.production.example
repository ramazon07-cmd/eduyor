# Store the filled file at /etc/eduyor/backend.env with mode 600. Never commit it.
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=eduyor.example
CSRF_TRUSTED_ORIGINS=https://eduyor.example
TRUST_PROXY_HTTPS=1
POSTGRES_DB=eduyor
POSTGRES_USER=eduyor
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# For a remote managed database, follow its TLS requirements (usually verify-full).
POSTGRES_SSLMODE=prefer
DJANGO_STATIC_ROOT=/srv/eduyor/shared/static
DJANGO_MEDIA_ROOT=/srv/eduyor/shared/media
PAYMENT_INSTRUCTIONS=
PAYMENT_SUPPORT="Administrator bilan bog‘laning"
# Brevo SMTP for sign-up codes (brevo.com > SMTP & API). Leave EMAIL_HOST empty to print codes to the console.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Must be a sender address verified in Brevo.
DEFAULT_FROM_EMAIL=EduYor <no-reply@example.com>
