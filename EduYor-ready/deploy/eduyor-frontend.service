[Unit]
Description=EduYor Next.js
After=network.target eduyor-backend.service

[Service]
Type=simple
User=eduyor
Group=www-data
WorkingDirectory=/srv/eduyor/frontend
EnvironmentFile=/etc/eduyor/frontend.env
ExecStart=/usr/bin/node /srv/eduyor/frontend/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
